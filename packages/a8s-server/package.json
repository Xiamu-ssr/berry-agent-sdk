{
  "name": "@berry-agent/a8s-server",
  "version": "0.5.0-alpha.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "berry-a8s": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js 2>/dev/null || true && npm run --silent build:ui --if-present",
    "build:ui": "if [ -d ui/node_modules ]; then cd ui && npm run build; else echo '[a8s-server] ui/node_modules missing; skipping UI build (run: cd packages/a8s-server/ui && npm install)'; fi",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@berry-agent/a8s": "*",
    "@berry-agent/a8s-admin": "*",
    "@berry-agent/cluster-protocol": "*",
    "@berry-agent/core": "*",
    "@berry-agent/models": "*",
    "@berry-agent/observe": "*",
    "@berry-agent/runtime": "*",
    "@berry-agent/worker": "*"
  },
  "optionalDependencies": {
    "@berry-agent/runtime-sqlite": "*"
  },
  "devDependencies": {
    "@berry-agent/runtime-sqlite": "*",
    "@berry-agent/machine-connector": "*",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}
