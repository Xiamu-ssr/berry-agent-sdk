{
  "name": "@berry-agent/config",
  "version": "0.5.0-alpha.0",
  "description": "SDK-level configuration loader for Berry Agent SDK. Single source of truth for provider/model/tier registries and process-wide defaults. Synchronous, uncached, no default path.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@berry-agent/models": "^0.5.0-alpha.0",
    "@berry-agent/safe": "^0.5.0-alpha.0",
    "@berry-agent/tools-common": "^0.5.0-alpha.0",
    "@berry-agent/observe": "^0.5.0-alpha.0"
  },
  "devDependencies": {
    "@berry-agent/core": "*",
    "@berry-agent/models": "*",
    "@berry-agent/safe": "*",
    "@berry-agent/tools-common": "*",
    "@berry-agent/observe": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^3.24.0"
  },
  "license": "MIT"
}
